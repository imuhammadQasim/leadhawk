# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadhawk

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=this-is-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP. Leave username/password empty to run locally without email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
