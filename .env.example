# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/leadhawk

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=this-is-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP. Leave username/password empty to run locally without email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Lead discovery (Agent 1). Get a key from Google Cloud Console with the
# Places API (New) enabled.
GOOGLE_PLACES_API_KEY=
# Weak-presence filter thresholds (defaults shown; a listing needs to miss
# just one of these, or have no/a broken website, to be kept as a lead).
LEAD_MIN_RATING=3.5
LEAD_MIN_REVIEWS=10
